{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build WCE (Debug)",
            "type": "process",
            "command": "cargo",
            "args": ["build", "-p", "wce_app"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "Build WCE (Release)",
            "type": "process",
            "command": "cargo",
            "args": ["build", "--release", "-p", "wce_app"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Run WCE (Debug build, without debugger)",
            "type": "process",
            "command": "cargo",
            "args": ["run", "-p", "wce_app"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Run WCE (Release build, without debugger)",
            "type": "process",
            "command": "cargo",
            "args": ["run", "--release", "-p", "wce_app"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Build All (Debug)",
            "type": "process",
            "command": "cargo",
            "args": ["build", "--workspace", "--bins", "--examples"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Run all tests",
            "type": "process",
            "command": "cargo",
            "args": ["test", "--workspace"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": "$rustc"
        }
    ]
}
